    "strategy-study": "tsx src/strategy-study.ts",
    "paper-evidence": "tsx src/paper-evidence.ts",
    "funded-replay": "tsx src/funded-replay.ts",
    "funded-historical-replay": "tsx src/funded-historical-replay.ts",
