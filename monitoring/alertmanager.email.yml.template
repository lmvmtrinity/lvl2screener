global:
  resolve_timeout: 5m
  smtp_smarthost: '__SMTP_SMARTHOST__'
  smtp_from: '__SMTP_FROM__'
  smtp_auth_username: '__SMTP_USERNAME__'
  smtp_auth_password_file: /etc/alertmanager/secrets/smtp-password
  smtp_require_tls: true

route:
  receiver: local-dashboard
  group_by: [alertname, market_id]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 1h
  routes:
    - receiver: critical-email
      matchers:
        - severity="critical"

receivers:
  - name: local-dashboard
  - name: critical-email
    email_configs:
      - to: '__EMAIL_TO__'
        send_resolved: true
        headers:
          Subject: '[Scanner {{ .Status | toUpper }}] {{ .CommonLabels.alertname }} {{ .CommonLabels.market_id }}'
        text: |
          Scanner alert: {{ .Status | toUpper }}
          {{ range .Alerts }}
          {{ .Annotations.summary }}
          Market: {{ .Labels.market_id }}
          {{ .Annotations.description }}
          Started: {{ .StartsAt }}
          {{ end }}
          Local dashboards: http://localhost:9090/alerts and http://localhost:5173
