# Local Docker Compose template. Copy to .env for a NEW installation.
# For an existing installation, merge new settings instead of overwriting .env:
# preserve APP_MASTER_KEY, database credentials/name, market flags and account IDs.
# Replacing APP_MASTER_KEY makes existing encrypted Questrade tokens unreadable.
# Compose recreates containers to load changed environment values; restart alone
# does not reload them. API startup also applies pending database migrations.
# Never commit .env or share its secrets.
#
# Live setup: change mock to live and fill the two Questrade secrets below.
# Add EODHD_API_TOKEN for discovery catalogs; it does not enable discovery.
MARKET_DATA_MODE=mock
QUESTRADE_REFRESH_TOKEN=
# 32 random bytes encoded as base64. Generate once and retain across upgrades.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
APP_MASTER_KEY=
EODHD_API_TOKEN=
# Optional free Massive (Polygon) key: selects the Massive US discovery catalog
# and supplies US corporate-action reference evidence. CA_TSX keeps EODHD.
MASSIVE_API_KEY=
# Questrade manual authorization needs no client ID or redirect URI. Enable
# account-information and market-data OAuth scopes. The refresh token bootstraps
# authorization; its rotated replacement is stored encrypted in PostgreSQL.
# Discovery mode is PostgreSQL-owned and initially OFF; live commissioning is separate.

# Service defaults for the local Compose network (not host-side pnpm processes).
# Compose fixes API_HOST/API_PORT and SCANNER_URL and constructs DATABASE_URL from
# POSTGRES_*; keep DATABASE_URL consistent if using it outside Compose.
API_HOST=0.0.0.0
API_PORT=3000
WEB_PORT=5173
WEB_BIND_ADDRESS=127.0.0.1
# Optional browser origin override; omit to follow WEB_PORT automatically in Compose.
# WEB_ORIGIN=http://localhost:5173
POSTGRES_DB=tsx_scanner
# W5: this default is only safe because the default Compose profile never publishes Postgres on
# the host (docker-compose.yml) -- it is not a production-grade secret. The optional remote-access
# profile refuses to start with this value; see docs/baseline/operations-runbook.md.
POSTGRES_USER=tsx_scanner
POSTGRES_PASSWORD=local_development_only
DATABASE_URL=postgresql://tsx_scanner:local_development_only@postgres:5432/tsx_scanner
SCANNER_URL=http://scanner:8000
# Verified research identity is generated by the build and checked against the
# scanner's actual source/runtime; no manually supplied hashes are trusted.
# W5: shared internal credential between api/worker and the scanner service (see
# services/scanner/app/main.py). Same "safe only because nothing external can reach the scanner"
# caveat as POSTGRES_PASSWORD above -- the remote profile refuses this default too.
SCANNER_SERVICE_TOKEN=local-development-only-scanner-token
LOG_LEVEL=info
MARKET_DATA_POLL_MS=2000
DISCOVERY_POLL_MS=15000
DISCOVERY_LEASE_MS=600000
DISCOVERY_WORKERS=4
# Discovery evidence maintenance is bounded and independent of provider discovery.
DISCOVERY_COMPACTION_ENABLED=true
DISCOVERY_COMPACTION_INTERVAL_MS=86400000
DISCOVERY_INPUT_RETENTION_DAYS=30
DISCOVERY_SUMMARY_RETENTION_DAYS=365
# Opt-in only: adds an external TradingView scan to every discovery cycle.
DISCOVERY_FAST_FUNNEL_ENABLED=false
QUOTE_BATCH_SIZE=50
UNIVERSE_MINIMUM_SIZE=1
UNIVERSE_MIN_PRICE=5
UNIVERSE_MAX_PRICE=150
UNIVERSE_MIN_MARKET_CAP=500000000
UNIVERSE_MIN_AVERAGE_VOLUME=500000
UNIVERSE_MIN_DOLLAR_VOLUME=20000000
UNIVERSE_MIN_ATR_PCT=1.5
# Optional first-run seed only. The normal live workflow pastes a fresh TradingView
# candidate list in the web app each Toronto trading day.
TSX_UNIVERSE_SYMBOLS=

# US equities are disabled by default. For CA + US observation, set BOTH:
# ENABLED_MARKETS=CA_TSX,US_EQUITIES and US_MARKET_DATA_ENABLED=true.
# Keep US_PAPER_TRADING_ENABLED=false for observation-only operation; follow
# private development record, then obtain explicit approval
# before setting US_PAPER_TRADING_ENABLED=true.
ENABLED_MARKETS=CA_TSX
US_MARKET_DATA_ENABLED=false
US_PAPER_TRADING_ENABLED=false
US_UNIVERSE_SYMBOLS=

# Stable context benchmarks are resolved independently from the daily candidate
# list. Sector mappings use instrument sector names returned by Questrade.
MARKET_BENCHMARK_SYMBOL=XIU.TO
SECTOR_BENCHMARK_SYMBOLS={"Basic Materials":"XMA.TO","Financial Services":"XFN.TO","Energy":"XEG.TO","Industrial":"XGI.TO","Technology":"XIT.TO","Utilities":"XUT.TO","Consumer Cyclical":"XCD.TO"}
BENCHMARK_MAX_STALENESS_SECONDS=30
US_MARKET_BENCHMARK_SYMBOL=SPY
US_SECTOR_BENCHMARK_SYMBOLS={"Technology":"XLK","Financial Services":"XLF","Energy":"XLE","Basic Materials":"XLB","Industrial":"XLI","Utilities":"XLU","Consumer Cyclical":"XLY"}

# Toronto session policy. The app stays running, warms before the open, scans at
# 09:45, permits normal READY signals from 10:00, and accepts new entries
# through the regular 16:00 TSX close. Entries after 11:30 are marked as
# outside the preferred window.
SESSION_TIMEZONE=America/Toronto
OPENING_RANGE_START=09:30
OPENING_RANGE_END=09:45
SCANNING_START=09:45
SCANNING_END=16:00
ENTRY_PREFERRED_START=10:00
ENTRY_PREFERRED_END=11:30
ENTRY_HARD_END=16:00

# US session policy. These local-market windows become active only when the
# authoritative Questrade US market-hours status is open.
US_SESSION_TIMEZONE=America/New_York

# Paper execution assumptions. Questrade currently charges no commission or
# ECN fee for online CAD-listed Canadian stock orders; bid/ask spread and
# slippage are still modeled independently.
PAPER_BOT_FEE_PER_TRADE=0
PAPER_BOT_SLIPPAGE_BPS=2
PAPER_BOT_RISK_BUDGET=100
PAPER_BOT_RISK_BUDGET_CAD=50
PAPER_BOT_RISK_BUDGET_USD=25
# Optional funded-paper account identities. Leave blank to keep the funded
# live adapter disabled. Account funding is immutable once provisioned.
PAPER_FUNDED_CAD_ACCOUNT_ID=
PAPER_FUNDED_USD_ACCOUNT_ID=
PAPER_FUNDED_INITIAL_CASH_CAD=10000
PAPER_FUNDED_INITIAL_CASH_USD=10000
PAPER_FUNDED_DAILY_LOSS_LIMIT_CAD=200
PAPER_FUNDED_DAILY_LOSS_LIMIT_USD=100
PAPER_BOT_MIN_NET_REWARD_RISK=1
PAPER_BOT_MIN_STOP_FRICTION_MULTIPLE=2
PAPER_BOT_MIN_TARGET_FRICTION_MULTIPLE=3
PAPER_BOT_MAX_SPREAD_PCT=0.5
PAPER_COORDINATION_MAX_SYMBOL_NOTIONAL=10000
PAPER_COORDINATION_MAX_SYMBOL_NOTIONAL_CAD=3000
PAPER_COORDINATION_MAX_SYMBOL_NOTIONAL_USD=1500
PAPER_COORDINATION_MAX_SECTOR_NOTIONAL=20000
PAPER_COORDINATION_MAX_SECTOR_NOTIONAL_CAD=5000
PAPER_COORDINATION_MAX_SECTOR_NOTIONAL_USD=2500
PAPER_COORDINATION_MAX_DISPLAYED_SIZE_PARTICIPATION=0.25
PAPER_COORDINATION_REQUIRE_FRESH_CONTEXT=true
PAPER_COORDINATION_CONTEXT_REQUIREMENT=MARKET_AND_SECTOR_REQUIRED
PAPER_COORDINATION_CONTEXT_MAX_AGE_SECONDS=300
PAPER_COORDINATION_VETO_ON_WEAK_CONTEXT=true
PAPER_COORDINATION_COOLDOWN_MINUTES_AFTER_STOP=15
PAPER_COORDINATION_MAX_OPEN_POSITIONS=3
PAPER_COORDINATION_MAX_TOTAL_OPEN_RISK=1000
PAPER_COORDINATION_MAX_TOTAL_OPEN_RISK_CAD=150
PAPER_COORDINATION_MAX_TOTAL_OPEN_RISK_USD=75
PAPER_COORDINATION_MAX_DAILY_LOSS=1000
PAPER_COORDINATION_MAX_DAILY_LOSS_CAD=200
PAPER_COORDINATION_MAX_DAILY_LOSS_USD=100
PAPER_COORDINATION_DAILY_LOSS_LIMIT_TYPE=CUMULATIVE_LOSS
PAPER_COORDINATION_RESERVE_REMAINING_DAILY_RISK=true
PAPER_COORDINATION_MAX_CONSECUTIVE_STOPS=3
PAPER_COORDINATION_MAX_HOLDING_MINUTES=45
PAPER_COORDINATION_MAX_HOLDING_MINUTES_BY_STRATEGY={}
PAPER_COORDINATION_STALLED_BREAKOUT_MINUTES=15
PAPER_COORDINATION_STALLED_BREAKOUT_MIN_PROGRESS_R=0.25

# W5: optional remote-access Compose profile (`docker compose --profile remote up`). Leave unset
# for the default localhost/private profile -- a single trusted operator on their own machine
# never sees a login screen. See docs/baseline/operations-runbook.md for
# how to generate OPERATOR_PASSWORD_HASH and a TLS certificate.
# REMOTE_ACCESS_ENABLED=true
# OPERATOR_PASSWORD_HASH= # scrypt:<saltHex>:<hashHex>
# SESSION_SECRET= # 32+ random characters, e.g. `openssl rand -hex 32`
# REMOTE_PORT=8443
# REMOTE_CERT_DIR=./certs

# Optional Prometheus/Alertmanager overlay. The default Compose profile does not start either
# service. Set an approved HTTPS/webhook receiver, run `pnpm monitoring:render`, then use
# `docker compose -f docker-compose.yml -f docker-compose.monitoring.yml --profile monitoring up -d`.
# ALERTMANAGER_WEBHOOK_URL=
# Email alternative: put these non-secret settings in .env.monitoring.
# Store only the SMTP app password in monitoring/secrets/smtp-password (Git-ignored).
# ALERTMANAGER_SMTP_SMARTHOST=smtp.gmail.com:587
# ALERTMANAGER_SMTP_FROM=sender@example.com
# ALERTMANAGER_SMTP_USERNAME=sender@example.com
# ALERTMANAGER_EMAIL_TO=recipient@example.com
# Run pnpm monitoring:render-email, then apply docker-compose.monitoring.email.yml last.

# Durable research worker scheduling (milliseconds).
RESEARCH_JOB_LEASE_MS=720000
RESEARCH_JOB_POLL_MS=2000

# Learning checks run daily at 17:00 America/New_York and at worker startup.
# Training remains gated by completed evidence and research qualification.
PAPER_MODEL_TRAINING_ENABLED=true
# Optional legacy interval override (milliseconds); leave empty for daily schedule.
PAPER_MODEL_TRAINING_CHECK_MS=

# A1 backtest automation: daily post-session qualification catch-up plus bounded
# startup catch-up. Opt-in; profile saves and explicit refreshes are always
# evaluated. Max outstanding bounds queued/running automated replays per market.
BACKTEST_AUTOMATION_ENABLED=false
BACKTEST_AUTOMATION_MAX_OUTSTANDING=2
